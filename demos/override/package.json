{
  "name": "agentverse-override",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.6" },
  "scripts": {
    "dev": "node server/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "loadtest": "node tests/loadtest.mjs",
    "cases:prompt": "node scripts/case-prompt.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": { "phaser": "3.90.0" },
  "devDependencies": { "typescript": "~5.9.3", "vite": "^7.3.1", "@types/node": "^22.19.0", "@playwright/test": "^1.58.2" }
}
