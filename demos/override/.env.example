# No credentials required for labeled, scripted rehearsal mode (the default).
# Set both key and model to enable live interviews with an OpenAI-compatible endpoint.
OVERRIDE_LLM_BASE_URL=https://api.openai.com/v1
OVERRIDE_LLM_API_KEY=
OVERRIDE_LLM_MODEL=
# Completion tokens include the model's internal reasoning. Truncated responses
# retry once at twice this limit (maximum 8192), within one shared timeout.
OVERRIDE_LLM_MAX_COMPLETION_TOKENS=2048
# Per-question deadline in ms: queue wait and all attempts count against it.
OVERRIDE_LLM_TIMEOUT_MS=60000

# Several endpoints with forward-only failover: path to a JSON array (see ops/endpoints.example.json).
# When set, the OVERRIDE_LLM_BASE_URL/_API_KEY/_MODEL variables above are ignored.
# OVERRIDE_ENDPOINTS=ops/endpoints.example.json
# OVERRIDE_ENDPOINT_A_KEY=
# OVERRIDE_ENDPOINT_B_KEY=
# OVERRIDE_ENDPOINT_C_KEY=
# OVERRIDE_ENDPOINT_D_KEY=
# Global cap on simultaneous LLM calls.
OVERRIDE_LLM_MAX_IN_FLIGHT=200
# Auto failover: this many failures within the window moves to the next endpoint.
OVERRIDE_LLM_FAILOVER_FAILURES=5
OVERRIDE_LLM_FAILOVER_WINDOW_MS=30000

# Optional shared access code for a hosted colleague demo.
OVERRIDE_ACCESS_CODE=
# Secret for signing sign-in tokens. Set it so sign-ins survive restarts (empty: random per process).
OVERRIDE_SECRET=
# 1 or true behind a proxy or tunnel: client address from CF-Connecting-IP, else X-Forwarded-For.
OVERRIDE_TRUST_PROXY=
PORT=3001
HOST=127.0.0.1

# Admin listener (127.0.0.1 only). It does not start while the token is empty.
OVERRIDE_ADMIN_TOKEN=
OVERRIDE_ADMIN_PORT=3002

# JSONL research records are stored outside the served web root, under <dir>/<OVERRIDE_ENV>/.
OVERRIDE_DATA_DIR=./data
# Name of the data subdirectory; use a different one for rehearsals.
OVERRIDE_ENV=live
# Recorded in session_started; empty means it is not set.
OVERRIDE_APP_COMMIT=
# 1 shows draft cases in the catalog and lets them start; ignored when NODE_ENV=production.
OVERRIDE_DEV_TOOLS=

# Coin budget for a whole investigation: empty means no budget, otherwise an integer 6-999.
OVERRIDE_COIN_BUDGET=
# Reasoning inspections per investigation: 1 or 2 (empty means 1).
OVERRIDE_REASONING_CHARGES=
