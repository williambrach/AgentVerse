# No credentials required for labeled, scripted rehearsal mode (the default).
# Set both key and model to enable live interviews with an OpenAI-compatible endpoint.
OVERRIDE_LLM_BASE_URL=https://api.openai.com/v1
OVERRIDE_LLM_API_KEY=
OVERRIDE_LLM_MODEL=
# Reasoning effort sent to the provider: low (the default when empty), medium, high,
# or none to send nothing for a model that rejects the field.
OVERRIDE_LLM_REASONING_EFFORT=low
# Completion tokens include the model's internal reasoning. Truncated responses
# retry once at twice this limit (maximum 8192), within one shared timeout.
OVERRIDE_LLM_MAX_COMPLETION_TOKENS=2048
# Per-question deadline in ms: queue wait and all attempts count against it.
OVERRIDE_LLM_TIMEOUT_MS=60000
# Interview answers stream token by token (the typewriter). 0, off or false switches the
# provider requests back to one buffered response; endpoints may also set "stream": false.
OVERRIDE_LLM_STREAM=1

# Several endpoints with forward-only failover: path to a JSON array (see ops/endpoints.example.json).
# When set, the OVERRIDE_LLM_BASE_URL/_API_KEY/_MODEL variables above are ignored.
# OVERRIDE_ENDPOINTS=ops/endpoints.example.json
# OVERRIDE_ENDPOINT_A_KEY=
# OVERRIDE_ENDPOINT_B_KEY=
# OVERRIDE_ENDPOINT_C_KEY=
# OVERRIDE_ENDPOINT_D_KEY=
# Global cap on simultaneous LLM calls.
OVERRIDE_LLM_MAX_IN_FLIGHT=300
# Auto failover: this many failures within the window moves to the next endpoint.
OVERRIDE_LLM_FAILOVER_FAILURES=5
OVERRIDE_LLM_FAILOVER_WINDOW_MS=30000

# Optional shared access code for a hosted colleague demo.
OVERRIDE_ACCESS_CODE=
# Secret for signing sign-in tokens. Set it so sign-ins survive restarts (empty: random per process).
OVERRIDE_SECRET=
# 1 or true behind a proxy or tunnel: client address from CF-Connecting-IP, else X-Forwarded-For.
OVERRIDE_TRUST_PROXY=
# Same for the admin port only (default off). Set it only if a proxy that overwrites the client-address headers sits in front of it.
OVERRIDE_ADMIN_TRUST_PROXY=
PORT=3001
HOST=127.0.0.1

# Admin listener (127.0.0.1 only). One password opens the whole admin panel. It does not start while the password is empty.
OVERRIDE_ADMIN_PASSWORD=
# Deprecated alias for OVERRIDE_ADMIN_PASSWORD. Set only one of them.
OVERRIDE_ADMIN_TOKEN=
OVERRIDE_ADMIN_PORT=3002
# Address the admin listener binds (default 127.0.0.1). docker-compose.yml sets 0.0.0.0 and publishes the port on loopback only.
OVERRIDE_ADMIN_HOST=
# Folder for the tracked content edits (content/cases/<id>.json and content/game.json). Empty means ./content.
OVERRIDE_CONTENT_DIR=
# Removed: maker tokens are ignored (with a warning). Use OVERRIDE_ADMIN_PASSWORD.
# OVERRIDE_MAKER_TOKENS=
# Extra Host names the admin listener accepts, comma separated, for a tunnel.
OVERRIDE_ADMIN_HOSTS=

# JSONL research records are stored outside the served web root, under <dir>/<OVERRIDE_ENV>/.
OVERRIDE_DATA_DIR=./data
# Name of the data subdirectory; use a different one for rehearsals.
OVERRIDE_ENV=live
# Recorded in session_started; empty means it is not set.
OVERRIDE_APP_COMMIT=
# 1 shows draft cases in the catalog and lets them start; ignored when NODE_ENV=production.
OVERRIDE_DEV_TOOLS=
# With dev tools on, an integer of seconds replaces the factory case's 600 s clock (warnings at 70% and 90%).
OVERRIDE_DEADLINE_SECONDS=
# Any string: every game deals its Let them talk speaking order from this seed, so a run can be replayed. Empty means the default seed 42069. Each game logs its seed in session_started as talkSeed.
OVERRIDE_TALK_SEED=

# Public base URL of the game (no trailing slash). The admin page links the big-screen board at <url>/?view=board. Empty means http://127.0.0.1:<port>.
OVERRIDE_PUBLIC_URL=
